# Supply through your shell or a secret manager; this file is not loaded automatically.
PORT=4317
FORGE_DB=data/forge.sqlite
# Optional: incoming signed GitHub webhooks
GITHUB_WEBHOOK_SECRET=
# Optional: read-only GitHub App installation access
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
# Optional operator-controlled local Git sources. Browser requests cannot set paths.
# FORGE_LOCAL_REPOSITORIES={"owner/repository":"C:/path/to/local/repository"}
